# supervisord.conf.example
#
# Example supervisord configuration for Fulcrum
# Use this to implement process-level crash recovery
#
# Usage:
#   1. Copy to container: COPY supervisord.conf /etc/supervisord.conf
#   2. Install supervisor: RUN apk add --no-cache supervisor
#   3. Update Dockerfile CMD: CMD ["/usr/bin/supervisord", "-c", "/etc/supervisord.conf"]

[unix_http_server]
file=/var/run/supervisor.sock
chmod=0700

[supervisord]
nodaemon=true
logfile=/var/log/supervisord.log
pidfile=/var/run/supervisord.pid
childlogdir=/var/log/supervisor
user=root
loglevel=info

[rpcinterface:supervisor]
supervisor.rpcinterface_factory = supervisor.rpcinterface:make_main_rpcinterface

[supervisorctl]
serverurl=unix:///var/run/supervisor.sock

# Fulcrum SPV Server
[program:fulcrum]
command=/usr/local/bin/Fulcrum /etc/fulcrum/fulcrum.conf
directory=/fulcrum
autostart=true
autorestart=true
startretries=10
startsecs=10
stopsignal=TERM
stopwaitsecs=30
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
environment=HOME="/fulcrum"

# Optional: Clean database before starting
# Uncomment if you want automatic cleanup on crash
# [program:pre-start-cleanup]
# command=/bin/sh -c "rm -rf /fulcrum/db/* && rm -rf /fulcrum/db/.lock-* || true"
# directory=/fulcrum
# autostart=true
# autorestart=false
# startsecs=0
# priority=1
# stdout_logfile=/dev/stdout
# stdout_logfile_maxbytes=0
# stderr_logfile=/dev/stderr
# stderr_logfile_maxbytes=0
